{
  "name": "where-at",
  "version": "1.0.1",
  "main": "index.js",
  "repository": "https://github.com/BunyodL/backend_samurai.git",
  "author": "BunyodL <bunyodcode@gmail.com>",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --inspect ./src/index.ts",
    "prebuild": "npm run typecheck",
    "build": "tsup && tsc-alias && npm run copy:sql",
    "postbuild": "echo build was successful",
    "start": "node ./dist/index.js",
    "typecheck": "tsc --noEmit",
    "copy:sql": "copyfiles -u 1 \"src/**/*.sql\" dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "seed": "tsx ./src/scripts/seed.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "argon2": "^0.45.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "pg": "^8.20.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.3",
    "@types/pg": "^8.20.0",
    "@types/swagger-ui-express": "^4.1.8",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.7.4",
    "tsc-alias": "^1.8.17",
    "tsup": "^8.5.1",
    "tsx": "^4.20.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.51.0"
  }
}
